# --- configuration ----------------------------------------------------------

def config_home():
    return os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")


def config_path():
    return os.path.join(config_home(), NAME, "config.ini")


def apps_paths():
    # A source checkout first, then the user's and the system's data dirs.
    here = os.path.dirname(os.path.realpath(__file__))
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    data_dirs = (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    return [os.path.join(here, "apps.ini")] + [os.path.join(d, NAME, "apps.ini") for d in [data_home, *data_dirs]]


# App entries are sections named "app <WM_CLASS name or glob>".
APP_SECTION = "app "
# Values passed on as written, comments included: a shell reads them.
VERBATIM = {"launcher_command"}
# A comment after a value: whitespace, then "#".
INLINE_COMMENT_RE = re.compile(r"(^|\s)#.*$", re.S)
TRUE, FALSE = ("1", "yes", "true", "on"), ("0", "no", "false", "off")


def read_ini(path):
    """Return {section: {key: raw string}} of an INI file, or None if it is missing or broken."""
    # Comments after values are stripped in checked(), as some values are shell
    # commands where ";" and "#" mean something.
    parser = configparser.ConfigParser(interpolation=None, default_section="\0")
    try:
        with open(path, encoding="utf-8") as f:
            parser.read_file(f)
    except FileNotFoundError:
        return None
    except (OSError, UnicodeDecodeError, configparser.Error) as e:
        warn(f"ignoring {path}: {e}")
        return None
    return {section: dict(parser[section]) for section in parser.sections()}


def convert(raw, default):
    """Convert an INI string to the type of default; raise ValueError if it does not fit."""
    value = raw.strip()
    # Accept quotes, as in TOML: zoom = "touch".
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        value = value[1:-1]
    if isinstance(default, bool):
        if value.lower() in TRUE:
            return True
        if value.lower() in FALSE:
            return False
        raise ValueError("expected yes or no")
    if isinstance(default, int):
        return int(value)
    if isinstance(default, float):
        return float(value)
    return value


def checked(table, defaults, where):
    """Return the entries of table that are known keys with valid values, converted."""
    out = {}
    for key, raw in table.items():
        if key not in defaults:
            warn(f"unknown key '{key}' in {where}")
            continue
        if key not in VERBATIM:
            raw = INLINE_COMMENT_RE.sub("", raw)
        try:
            value = convert(raw, defaults[key])
        except ValueError:
            warn(f"bad value '{raw}' for '{key}' in {where}")
            continue
        if key in CHOICES and value not in CHOICES[key]:
            warn(f"'{key}' must be one of {', '.join(c or '(empty)' for c in CHOICES[key])} in {where}")
        else:
            out[key] = value
    return out


def app_sections(ini, path):
    """Yield (WM_CLASS name or glob, table) of the app sections of ini."""
    for section, table in ini.items():
        if section.startswith(APP_SECTION) and section[len(APP_SECTION):].strip():
            yield section[len(APP_SECTION):].strip(), table


def load_config():
    """Return (settings by section, default app settings, {WM_CLASS: app settings})."""
    apps = {}
    for path in apps_paths():
        db = read_ini(path)
        if db is not None:
            for name, table in app_sections(db, path):
                apps[name] = checked(table, APP_DEFAULTS, f"[{APP_SECTION}{name}] of {path}")
            for section in db:
                if not section.startswith(APP_SECTION):
                    warn(f"unknown section [{section}] in {path}")
            break
    else:
        warn("apps.ini not found; every app gets the default zoom method")

    conf = {section: dict(values) for section, values in DEFAULTS.items()}
    default_app = dict(APP_DEFAULTS)
    path = config_path()
    user = read_ini(path) or {}
    for section, table in user.items():
        if section in DEFAULTS:
            conf[section].update(checked(table, DEFAULTS[section], f"[{section}] of {path}"))
        elif section == "pinch.default":
            default_app.update(checked(table, APP_DEFAULTS, f"[{section}] of {path}"))
        elif not section.startswith(APP_SECTION):
            warn(f"unknown section [{section}] in {path}")
    for name, table in app_sections(user, path):
        apps[name] = {**apps.get(name, {}), **checked(table, APP_DEFAULTS, f"[{APP_SECTION}{name}] of {path}")}
    return conf, default_app, apps


