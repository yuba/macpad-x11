#!/usr/bin/env python3
"""macOS-style touchpad gestures for X11.

Reads `libinput debug-events` and provides:

drag   Three-finger drag. A three-finger swipe presses the left button and
       moves the pointer; the button stays held for a short grace period
       after the fingers are lifted so the drag can be resumed. Any one-finger
       motion, click or scroll during the grace period ends the drag.

pinch  Pinch to zoom around the pointer. How each application is driven is
       data, not code: apps.toml maps WM_CLASS names to generic methods, and
       config.toml can override them.
         zoom = "touch"  Replay the pinch on a virtual uinput touchscreen with
                         one finger on the pointer. Apps that handle
                         touchscreen pinches (Chromium, Electron, some GTK)
                         zoom and pan smoothly around it.
         zoom = "wheel"  Wheel clicks at the pointer, optionally with a
                         modifier held.
         zoom = "keys"   Key presses; most apps zoom around their center.
         zoom = "none"   Leave the pinch alone.
         pan = "wheel"   Pan with wheel clicks while pinching (wheel/keys).

The daemon must stay resident: libinput does not track touches that were
already on the touchpad when it started.
"""
import ctypes
import fcntl
import fnmatch
import math
import os
import re
import select
import signal
import struct
import subprocess
import sys
import time
import tomllib
import traceback

__version__ = "0.2.1"

NAME = "macpad-x11"

DEFAULTS = {
    "drag": {
        "enabled": True,
        # Grace period after lifting the fingers, in seconds.
        "timeout": 0.5,
        # Ignore pointer events for this long right after the swipe ends, in seconds.
        "lift_guard": 0.0,
        # Pointer movement per unit of swipe movement.
        "speed": 3.0,
        # Number of fingers that start a drag.
        "fingers": 3,
    },
    "pinch": {
        "enabled": True,
        # Finger distance at the start of a touch pinch, in pixels.
        "spread": 400,
        # Finger distance change before a touch pinch starts, in pixels. Smaller
        # movements make apps see a two-finger tap (context menu).
        "slop": 40,
        # Pan movement per unit of finger movement; negative values reverse it.
        "pan_speed": 1.0,
        # Pan movement per wheel click for pan = "wheel", in pixels.
        "pan_step": 40,
    },
}

# Per-app pinch settings, used where neither apps.toml nor config.toml says otherwise.
APP_DEFAULTS = {
    "zoom": "keys",
    # Modifier held during zoom wheel clicks.
    "modifier": "",
    # Keys for zoom = "keys", as modifier+...+keysym.
    "zoom_in": "ctrl+plus",
    "zoom_out": "ctrl+minus",
    # Scale change per wheel click or key press.
    "step": 1.2,
    "pan": "none",
    # Horizontal wheel panning: "buttons" (6/7) or "shift" (Shift+4/5).
    "pan_horizontal": "buttons",
    # Apply the entry only if the app's process has this environment
    # variable ("NAME=VALUE", or "NAME" for any value); "" for always.
    "requires_env": "",
}

CHOICES = {
    "zoom": ("touch", "wheel", "keys", "none"),
    "modifier": ("", "ctrl", "shift", "alt", "super"),
    "pan": ("wheel", "none"),
    "pan_horizontal": ("buttons", "shift"),
}

# Events that end the drag during the grace period.
RELEASE_EVENTS = {
    "POINTER_MOTION",
    "POINTER_BUTTON",
    "POINTER_SCROLL_FINGER",
    "POINTER_SCROLL_WHEEL",
    "POINTER_SCROLL_CONTINUOUS",
    "GESTURE_PINCH_BEGIN",
}

# Accelerated "dx/ dy" of GESTURE_*_UPDATE.
DELTA_RE = re.compile(r"(-?\d+\.\d+)/\s*(-?\d+\.\d+)")
# Trailing "scale @ angle" of GESTURE_PINCH_UPDATE.
SCALE_RE = re.compile(r"(\d+\.\d+)\s+@\s+-?\d+\.\d+\s*$")


def warn(msg):
    print(f"{NAME}: {msg}", file=sys.stderr)


# --- configuration ----------------------------------------------------------

def config_home():
    return os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")


def config_path():
    return os.path.join(config_home(), NAME, "config.toml")


def apps_paths():
    # A source checkout first, then the user's and the system's data dirs.
    here = os.path.dirname(os.path.realpath(__file__))
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    data_dirs = (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    return [os.path.join(here, "apps.toml")] + [os.path.join(d, NAME, "apps.toml") for d in [data_home, *data_dirs]]


def read_toml(path):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        return None
    except (OSError, tomllib.TOMLDecodeError) as e:
        warn(f"ignoring {path}: {e}")
        return None


def checked(table, defaults, where):
    """Return the entries of table that are known keys with valid values."""
    out = {}
    if not isinstance(table, dict):
        warn(f"{where} must be a table")
        return out
    for key, value in table.items():
        if key not in defaults:
            warn(f"unknown key '{key}' in {where}")
        elif type(value) is not type(defaults[key]) and not (
                isinstance(defaults[key], float) and isinstance(value, int) and not isinstance(value, bool)):
            warn(f"'{key}' has the wrong type in {where}")
        elif key in CHOICES and value not in CHOICES[key]:
            warn(f"'{key}' must be one of {', '.join(map(repr, CHOICES[key]))} in {where}")
        else:
            out[key] = value
    return out


def load_config():
    """Return (settings by section, default app settings, {WM_CLASS: app settings})."""
    apps = {}
    for path in apps_paths():
        db = read_toml(path)
        if db is not None:
            for cls, table in db.items():
                apps[cls] = checked(table, APP_DEFAULTS, f"[{cls}] of {path}")
            break
    else:
        warn("apps.toml not found; every app gets the default zoom method")

    conf = {section: dict(values) for section, values in DEFAULTS.items()}
    default_app = dict(APP_DEFAULTS)
    path = config_path()
    user = read_toml(path)
    if user is None:
        # Settings of three-finger-drag, which this program grew out of.
        legacy = os.path.join(config_home(), "three-finger-drag", "config.toml")
        old = read_toml(legacy)
        if old:
            warn(f"using {legacy} as [drag]; move it to {path}")
            user = {"drag": old}
    user = user or {}
    for section in DEFAULTS:
        table = dict(user.pop(section, None) or {})
        if section == "pinch":
            default_app.update(checked(table.pop("default", None) or {}, APP_DEFAULTS, f"[pinch.default] of {path}"))
        conf[section].update(checked(table, DEFAULTS[section], f"[{section}] of {path}"))
    for cls, table in (user.pop("apps", None) or {}).items():
        apps[cls] = {**apps.get(cls, {}), **checked(table, APP_DEFAULTS, f"[apps.{cls}] of {path}")}
    for key in user:
        warn(f"unknown key '{key}' in {path}")
    return conf, default_app, apps


