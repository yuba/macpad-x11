if os.environ.get("XDG_SESSION_TYPE") == "wayland":
    sys.exit(f"{NAME}: X11 only (Wayland session detected)")

conf, default_app, apps = load_config()
display = X()
drag = Drag(display, conf["drag"]) if conf["drag"]["enabled"] else None
pinch = Pinch(display, conf["pinch"], default_app, apps) if conf["pinch"]["enabled"] else None
swipe = None
if conf["swipe"]["enabled"]:
    if drag and conf["swipe"]["fingers"] == conf["drag"]["fingers"]:
        warn(f"[swipe] and [drag] both use {conf['drag']['fingers']} fingers; desktop switching is off")
    else:
        swipe = Swipe(display, conf["swipe"], DesktopHud(display) if conf["swipe"]["hud"] else None)
pinch4 = None
if conf["pinch4"]["enabled"]:
    if pinch and conf["pinch4"]["fingers"] == 2:
        warn("[pinch4] uses 2 fingers like [pinch]; the four-finger pinch is off")
    else:
        pinch4 = FourPinch(display, conf["pinch4"], FingerHud(display) if conf["pinch4"]["hud"] else None)
features = [f for f in (drag, pinch, swipe, pinch4) if f]
failed = set()


def dispatch(line):
    event, fingers = parse(line)
    if not event:
        return
    for f in features:
        # A bug in one gesture must not take the others down.
        try:
            f.handle(event, fingers, line)
        except Exception:
            if type(f) not in failed:
                failed.add(type(f))
                warn(f"error in {type(f).__name__.lower()}:\n{traceback.format_exc()}")


def shutdown(*_):
    if drag:
        drag.release()
    if pinch:
        pinch.close()
    if swipe:
        swipe.close()
    if pinch4:
        pinch4.close()
    sys.exit(0)


def reload(*_):
    new_conf, new_default, new_apps = load_config()
    if drag:
        drag.conf = new_conf["drag"]
    if pinch:
        pinch.conf = new_conf["pinch"]
        pinch.configure(new_conf["pinch"], new_default, new_apps)
    if swipe:
        swipe.conf = new_conf["swipe"]
    if pinch4:
        pinch4.conf = new_conf["pinch4"]


signal.signal(signal.SIGTERM, shutdown)
signal.signal(signal.SIGINT, shutdown)
# Reload the config file and apps.ini (enabling or disabling a feature needs a restart).
signal.signal(signal.SIGHUP, reload)
# Release the drag immediately (e.g. from another gesture tool).
signal.signal(signal.SIGUSR1, lambda *_: drag and drag.release())

libinput = subprocess.Popen(
    ["stdbuf", "-oL", "libinput", "debug-events"],
    stdout=subprocess.PIPE,
    bufsize=0,
)
fd = libinput.stdout.fileno()
buf = b""

timed = [f for f in (drag, swipe, pinch4) if f]
while True:
    deadlines = [d for d in (f.deadline() for f in timed) if d is not None]
    wait = max(0.0, min(deadlines) - time.monotonic()) if deadlines else None
    ready, _, _ = select.select([fd], [], [], wait)
    for f in timed:
        f.tick(time.monotonic())
    if not ready:
        continue
    chunk = os.read(fd, 65536)
    if not chunk:
        # libinput exited (e.g. no permission on /dev/input); let systemd restart us.
        if drag:
            drag.release()
        if pinch:
            pinch.close()
        if swipe:
            swipe.close()
        if pinch4:
            pinch4.close()
        sys.exit(f"{NAME}: libinput debug-events exited (is the user in the 'input' group?)")
    *lines, buf = (buf + chunk).split(b"\n")
    for line in lines:
        dispatch(line.decode(errors="replace"))
