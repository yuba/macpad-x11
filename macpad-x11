class XClassHint(ctypes.Structure):
    # Pointers, not c_char_p, so that they can be handed back to XFree.
    _fields_ = [("res_name", ctypes.c_void_p), ("res_class", ctypes.c_void_p)]


x11 = ctypes.cdll.LoadLibrary("libX11.so.6")
xtst = ctypes.cdll.LoadLibrary("libXtst.so.6")
Window = ctypes.c_ulong
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XFlush.argtypes = [ctypes.c_void_p]
x11.XDefaultRootWindow.restype = Window
x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x11.XDefaultScreen.argtypes = [ctypes.c_void_p]
x11.XDisplayWidth.argtypes = x11.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]
x11.XQueryPointer.argtypes = [ctypes.c_void_p, Window, ctypes.POINTER(Window), ctypes.POINTER(Window),
                              *[ctypes.POINTER(ctypes.c_int)] * 4, ctypes.POINTER(ctypes.c_uint)]
x11.XQueryTree.argtypes = [ctypes.c_void_p, Window, ctypes.POINTER(Window), ctypes.POINTER(Window),
                           ctypes.POINTER(ctypes.POINTER(Window)), ctypes.POINTER(ctypes.c_uint)]
x11.XGetClassHint.argtypes = [ctypes.c_void_p, Window, ctypes.POINTER(XClassHint)]
x11.XInternAtom.restype = ctypes.c_ulong
x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
x11.XGetWindowProperty.argtypes = [ctypes.c_void_p, Window, ctypes.c_ulong, ctypes.c_long, ctypes.c_long,
                                   ctypes.c_int, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong),
                                   ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_ulong),
                                   ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_void_p)]
XA_CARDINAL = 6
x11.XFree.argtypes = [ctypes.c_void_p]
x11.XStringToKeysym.restype = ctypes.c_ulong
x11.XStringToKeysym.argtypes = [ctypes.c_char_p]
x11.XKeysymToKeycode.restype = ctypes.c_ubyte
x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
x11.XkbKeycodeToKeysym.restype = ctypes.c_ulong
x11.XkbKeycodeToKeysym.argtypes = [ctypes.c_void_p, ctypes.c_ubyte, ctypes.c_int, ctypes.c_int]
xtst.XTestFakeButtonEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
xtst.XTestFakeKeyEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
xtst.XTestFakeMotionEvent.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_ulong]
xtst.XTestFakeRelativeMotionEvent.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_ulong]
# Windows can vanish while we look at them; ignore the resulting X errors.
X_ERROR_HANDLER = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)(lambda d, e: 0)
x11.XSetErrorHandler(X_ERROR_HANDLER)

MODIFIER_KEYSYMS = {"ctrl": "Control_L", "shift": "Shift_L", "alt": "Alt_L", "super": "Super_L"}


class X:
    def __init__(self):
        self.dpy = x11.XOpenDisplay(None)
        if not self.dpy:
            sys.exit(f"{NAME}: cannot open display (is DISPLAY set?)")
        self.root = x11.XDefaultRootWindow(self.dpy)
        self.screen = x11.XDefaultScreen(self.dpy)
        self.width = x11.XDisplayWidth(self.dpy, self.screen)
        self.height = x11.XDisplayHeight(self.dpy, self.screen)

    def flush(self):
        x11.XFlush(self.dpy)

    def button(self, button, down):
        xtst.XTestFakeButtonEvent(self.dpy, button, int(down), 0)
        self.flush()

    def click(self, button, modifier=""):
        mods = [modifier] if modifier else []
        self._mods(mods, True)
        xtst.XTestFakeButtonEvent(self.dpy, button, 1, 0)
        xtst.XTestFakeButtonEvent(self.dpy, button, 0, 0)
        self._mods(mods, False)
        self.flush()

    def key(self, spec):
        """Press and release spec, e.g. "ctrl+plus" (modifiers, then a keysym)."""
        *mods, name = spec.split("+") if not spec.endswith("++") else [*spec[:-2].split("+"), "plus"]
        keysym = x11.XStringToKeysym(name.encode())
        code = x11.XKeysymToKeycode(self.dpy, keysym) if keysym else 0
        if not code:
            warn(f"no key for '{name}' in '{spec}'")
            return
        # Keysyms on the shifted level (like "plus" on US layouts) need Shift.
        if x11.XkbKeycodeToKeysym(self.dpy, code, 0, 0) != keysym and \
                x11.XkbKeycodeToKeysym(self.dpy, code, 0, 1) == keysym and "shift" not in mods:
            mods.append("shift")
        self._mods(mods, True)
        xtst.XTestFakeKeyEvent(self.dpy, code, 1, 0)
        xtst.XTestFakeKeyEvent(self.dpy, code, 0, 0)
        self._mods(mods, False)
        self.flush()

    def _mods(self, mods, down):
        for m in (mods if down else reversed(mods)):
            code = x11.XKeysymToKeycode(self.dpy, x11.XStringToKeysym(MODIFIER_KEYSYMS.get(m, m).encode()))
            if code:
                xtst.XTestFakeKeyEvent(self.dpy, code, int(down), 0)

    def move_by(self, dx, dy):
        xtst.XTestFakeRelativeMotionEvent(self.dpy, dx, dy, 0)
        self.flush()

    def move_to(self, x, y):
        xtst.XTestFakeMotionEvent(self.dpy, self.screen, x, y, 0)
        self.flush()

    def pointer(self):
        """Return (x, y, the application window under the pointer or 0)."""
        root, child = Window(), Window()
        rx, ry, wx, wy = (ctypes.c_int() for _ in range(4))
        mask = ctypes.c_uint()
        x11.XQueryPointer(self.dpy, self.root, ctypes.byref(root), ctypes.byref(child),
                          ctypes.byref(rx), ctypes.byref(ry), ctypes.byref(wx), ctypes.byref(wy), ctypes.byref(mask))
        return rx.value, ry.value, self._client(child.value, 3) if child.value else 0

    def _client(self, win, depth):
        # The child of the root is usually the window manager's frame; the
        # application's window (the one with WM_CLASS) is somewhere inside.
        if self.names(win):
            return win
        if depth == 0:
            return 0
        root, parent = Window(), Window()
        children, n = ctypes.POINTER(Window)(), ctypes.c_uint()
        if not x11.XQueryTree(self.dpy, win, ctypes.byref(root), ctypes.byref(parent),
                              ctypes.byref(children), ctypes.byref(n)):
            return 0
        try:
            for i in reversed(range(n.value)):
                client = self._client(children[i], depth - 1)
                if client:
                    return client
        finally:
            if children:
                x11.XFree(ctypes.cast(children, ctypes.c_void_p))
        return 0

    def names(self, win):
        """Return the (class, instance) of win's WM_CLASS, or None."""
        hint = XClassHint()
        if not win or not x11.XGetClassHint(self.dpy, win, ctypes.byref(hint)):
            return None
        names = tuple(ctypes.string_at(p).decode(errors="replace") if p else ""
                      for p in (hint.res_class, hint.res_name))
        for p in (hint.res_name, hint.res_class):
            if p:
                x11.XFree(p)
        return names

    def pid(self, win):
        """Return the _NET_WM_PID of win, or None."""
        if not win:
            return None
        atom = x11.XInternAtom(self.dpy, b"_NET_WM_PID", True)
        if not atom:
            return None
        actual_type, actual_format = ctypes.c_ulong(), ctypes.c_int()
        nitems, after, prop = ctypes.c_ulong(), ctypes.c_ulong(), ctypes.c_void_p()
        if x11.XGetWindowProperty(self.dpy, win, atom, 0, 1, False, XA_CARDINAL,
                                  ctypes.byref(actual_type), ctypes.byref(actual_format),
                                  ctypes.byref(nitems), ctypes.byref(after), ctypes.byref(prop)) != 0:
            return None
        try:
            # Format-32 properties come back as an array of C longs.
            if actual_format.value == 32 and nitems.value >= 1 and prop.value:
                return ctypes.cast(prop, ctypes.POINTER(ctypes.c_ulong))[0]
            return None
        finally:
            if prop.value:
                x11.XFree(prop)


# --- virtual touchscreen ----------------------------------------------------

EV_SYN, EV_KEY, EV_ABS = 0x00, 0x01, 0x03
BTN_TOUCH, BTN_TOOL_FINGER, BTN_TOOL_DOUBLETAP = 0x14A, 0x145, 0x14D
ABS_X, ABS_Y = 0x00, 0x01
ABS_MT_SLOT, ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 0x2F, 0x35, 0x36, 0x39
INPUT_PROP_DIRECT = 0x01
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT, UI_SET_PROPBIT = 0x40045564, 0x40045565, 0x40045567, 0x4004556E
UI_DEV_SETUP, UI_ABS_SETUP = 0x405C5503, 0x401C5504
UI_DEV_CREATE, UI_DEV_DESTROY = 0x5501, 0x5502


class Touchscreen:
    """A uinput two-finger touchscreen covering the X screen; units are pixels."""

    def __init__(self, width, height):
        self.width, self.height = width, height
        self.fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        for ev in (EV_SYN, EV_KEY, EV_ABS):
            fcntl.ioctl(self.fd, UI_SET_EVBIT, ev)
        for key in (BTN_TOUCH, BTN_TOOL_FINGER, BTN_TOOL_DOUBLETAP):
            fcntl.ioctl(self.fd, UI_SET_KEYBIT, key)
        fcntl.ioctl(self.fd, UI_SET_PROPBIT, INPUT_PROP_DIRECT)
        for code, top in ((ABS_X, width - 1), (ABS_Y, height - 1), (ABS_MT_SLOT, 1),
                          (ABS_MT_POSITION_X, width - 1), (ABS_MT_POSITION_Y, height - 1),
                          (ABS_MT_TRACKING_ID, 65535)):
            fcntl.ioctl(self.fd, UI_SET_ABSBIT, code)
            # struct uinput_abs_setup: code, then input_absinfo (value, min, max, fuzz, flat, resolution)
            fcntl.ioctl(self.fd, UI_ABS_SETUP, struct.pack("HxxiiiiII", code, 0, 0, top, 0, 0, 0))
        # struct uinput_setup: input_id (bustype, vendor, product, version), name[80], ff_effects_max
        fcntl.ioctl(self.fd, UI_DEV_SETUP,
                    struct.pack("HHHH80sI", 0x06, 0x1234, 0x5678, 1, f"{NAME} virtual touchscreen".encode(), 0))
        fcntl.ioctl(self.fd, UI_DEV_CREATE)
        self.touching = False

    def _emit(self, events):
        os.write(self.fd, b"".join(struct.pack("llHHi", 0, 0, t, c, v) for t, c, v in events)
                 + struct.pack("llHHi", 0, 0, EV_SYN, 0, 0))

    def move(self, fingers):
        """Put the two fingers at the given (x, y) positions, touching down if needed."""
        events = []
        for slot, (x, y) in enumerate(fingers):
            x, y = max(0, min(self.width - 1, round(x))), max(0, min(self.height - 1, round(y)))
            events.append((EV_ABS, ABS_MT_SLOT, slot))
            if not self.touching:
                events.append((EV_ABS, ABS_MT_TRACKING_ID, slot + 1))
            events += [(EV_ABS, ABS_MT_POSITION_X, x), (EV_ABS, ABS_MT_POSITION_Y, y)]
            if slot == 0:
                events += [(EV_ABS, ABS_X, x), (EV_ABS, ABS_Y, y)]
        if not self.touching:
            events += [(EV_KEY, BTN_TOUCH, 1), (EV_KEY, BTN_TOOL_DOUBLETAP, 1)]
            self.touching = True
        self._emit(events)

    def lift(self):
        if self.touching:
            self._emit([(EV_ABS, ABS_MT_SLOT, 0), (EV_ABS, ABS_MT_TRACKING_ID, -1),
                        (EV_ABS, ABS_MT_SLOT, 1), (EV_ABS, ABS_MT_TRACKING_ID, -1),
                        (EV_KEY, BTN_TOUCH, 0), (EV_KEY, BTN_TOOL_DOUBLETAP, 0)])
            self.touching = False

    def close(self):
        self.lift()
        fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        os.close(self.fd)


# --- gestures ---------------------------------------------------------------

def parse(line):
    """Return (event, finger count or None) of a debug-events line."""
    fields = line.split()
    if len(fields) < 2:
        return None, None
    # The finger count follows the timestamp ("+1.234s"); UPDATE lines have a
    # sequence number before the timestamp, so locate it by position.
    t = next((i for i, f in enumerate(fields) if f.startswith("+") and f.endswith("s")), None)
    fingers = fields[t + 1] if t is not None and t + 1 < len(fields) else None
    return fields[1], int(fingers) if fingers and fingers.isdigit() else None


class Drag:
    IDLE, DRAGGING, GRACE = "idle", "dragging", "grace"

    def __init__(self, x, conf):
        self.x, self.conf = x, conf
        self.state = self.IDLE
        self.grace_since = 0.0
        # Sub-pixel remainder carried over between updates.
        self.rest_x = self.rest_y = 0.0

    def deadline(self):
        return self.grace_since + self.conf["timeout"] if self.state == self.GRACE else None

    def tick(self, now):
        if self.state == self.GRACE and now >= self.deadline():
            self.release()

    def release(self):
        if self.state != self.IDLE:
            self.x.button(1, False)
        self.state = self.IDLE

    def handle(self, event, fingers, line):
        if event.startswith("GESTURE_SWIPE_") and fingers == self.conf["fingers"]:
            if event == "GESTURE_SWIPE_BEGIN":
                if self.state == self.IDLE:
                    self.x.button(1, True)
                self.state = self.DRAGGING
                self.rest_x = self.rest_y = 0.0
            elif event == "GESTURE_SWIPE_UPDATE" and self.state == self.DRAGGING:
                m = DELTA_RE.search(line)
                if m:
                    self.rest_x += float(m.group(1)) * self.conf["speed"]
                    self.rest_y += float(m.group(2)) * self.conf["speed"]
                    dx, dy = int(self.rest_x), int(self.rest_y)
                    if dx or dy:
                        self.rest_x -= dx
                        self.rest_y -= dy
                        self.x.move_by(dx, dy)
            elif event == "GESTURE_SWIPE_END" and self.state == self.DRAGGING:
                self.state = self.GRACE
                self.grace_since = time.monotonic()
            return
        if self.state == self.GRACE and event in RELEASE_EVENTS \
                and time.monotonic() - self.grace_since >= self.conf["lift_guard"]:
            self.release()


def has_env(pid, requirement):
    """Whether process pid has requirement ("NAME=VALUE", or "NAME" set to anything) in its environment."""
    try:
        with open(f"/proc/{int(pid)}/environ", "rb") as f:
            env = f.read().split(b"\0")
    except (TypeError, ValueError, OSError):
        # No _NET_WM_PID, another user's process, or a pid from a sandbox's
        # own namespace (Flatpak): we cannot tell, so assume not.
        return False
    want = requirement.encode()
    if b"=" in want:
        return want in env
    return any(e.startswith(want + b"=") and len(e) > len(want) + 1 for e in env)


class Pinch:
    def __init__(self, x, conf, default_app, apps):
        self.x = x
        self.configure(conf, default_app, apps)
        try:
            self.touch = Touchscreen(x.width, x.height)
        except OSError as e:
            warn(f"cannot create the virtual touchscreen ({e}); zoom = \"touch\" falls back to \"keys\". "
                 "Is the user in the 'input' group?")
            self.touch = None
        # Settings of the app being pinched, or None between pinches.
        self.app = None

    def configure(self, conf, default_app, apps):
        self.conf, self.default_app, self.apps = conf, default_app, apps
        self.apps_folded = {key.lower(): table for key, table in apps.items()}
        # Keys like "vivaldi*" cover the names an app gets from different
        # packagings (Vivaldi-stable, Vivaldi-flatpak, ...).
        self.apps_globbed = [(key.lower(), table) for key, table in apps.items() if any(c in key for c in "*?[")]

    def settings(self, names, pid=None):
        # The class name first, then the instance name (some toolkits use a
        # generic class, e.g. "dotnet"): exactly, ignoring case, then by glob.
        names = [n for n in names if n]
        table = next((t for t in (*(self.apps.get(n) for n in names),
                                  *(self.apps_folded.get(n.lower()) for n in names)) if t is not None), None)
        if table is None:
            table = next((t for key, t in self.apps_globbed
                          if any(fnmatch.fnmatchcase(n.lower(), key) for n in names)), {})
        # Some apps handle a method only when started with some environment
        # variable; without it, they get the default instead.
        if table.get("requires_env") and not has_env(pid, table["requires_env"]):
            table = {}
        app = {**self.default_app, **table}
        if app["zoom"] == "touch" and not self.touch:
            app["zoom"] = "keys"
        return app

    def handle(self, event, fingers, line):
        if not event.startswith("GESTURE_PINCH_") or fingers != 2:
            return
        if event == "GESTURE_PINCH_BEGIN":
            self.begin()
        elif event == "GESTURE_PINCH_UPDATE" and self.app:
            m, d = SCALE_RE.search(line), DELTA_RE.search(line)
            if m and d and float(m.group(1)) > 0:
                self.update(float(m.group(1)), float(d.group(1)), float(d.group(2)))
        elif event == "GESTURE_PINCH_END":
            self.end()

    def begin(self):
        # The anchor is the pointer at the start of the pinch.
        self.cx, self.cy, win = self.x.pointer()
        self.app = self.settings(self.x.names(win) or ("", ""), self.x.pid(win))
        self.pan_x = self.pan_y = 0.0
        self.step_scale = 1.0
        if self.app["zoom"] == "touch":
            # Move the second finger toward the farthest screen corner so it
            # stays on screen as long as possible.
            w, h = self.x.width, self.x.height
            room_x = w - 1 - self.cx if self.cx < w / 2 else -self.cx
            room_y = h - 1 - self.cy if self.cy < h / 2 else -self.cy
            self.dist_max = max(1.0, math.hypot(room_x, room_y))
            self.axis = (room_x / self.dist_max, room_y / self.dist_max)
            self.dist0 = max(8.0, min(self.conf["spread"], self.dist_max / 4))

    def update(self, scale, dx, dy):
        self.pan_x += dx * self.conf["pan_speed"]
        self.pan_y += dy * self.conf["pan_speed"]
        zoom = self.app["zoom"]
        if zoom == "touch":
            dist = self.dist0 * scale
            if not self.touch.touching:
                if max(abs(min(dist, self.dist_max) - self.dist0), abs(self.pan_x), abs(self.pan_y)) \
                        < self.conf["slop"]:
                    return
                self.touch.move(self.fingers(self.dist0, 0, 0))
            self.touch.move(self.fingers(dist, self.pan_x, self.pan_y))
            return
        if zoom in ("wheel", "keys"):
            step = self.app["step"]
            while scale / self.step_scale >= step:
                self.zoom_step(True)
                self.step_scale *= step
            while self.step_scale / scale >= step:
                self.zoom_step(False)
                self.step_scale /= step
        if self.app["pan"] == "wheel":
            self.pan_steps()

    def fingers(self, dist, ox, oy):
        # The first finger sits on the anchor and the second one moves.
        # Content follows the fingers in a touch pinch, so the anchor stays
        # put, and X's pointer emulation (which tracks the first touch) leaves
        # the pointer there. Panning moves both fingers, and the pointer.
        dist = min(dist, self.dist_max)
        x0, y0 = self.cx + ox, self.cy + oy
        return (x0, y0), (x0 + self.axis[0] * dist, y0 + self.axis[1] * dist)

    def zoom_step(self, zoom_in):
        if self.app["zoom"] == "wheel":
            self.x.click(4 if zoom_in else 5, self.app["modifier"])
        else:
            self.x.key(self.app["zoom_in" if zoom_in else "zoom_out"])

    def pan_steps(self):
        # Content follows the fingers: moving them down scrolls up (button 4),
        # moving them right scrolls left (button 6 or Shift+4).
        step = self.conf["pan_step"]
        while abs(self.pan_y) >= step:
            self.x.click(4 if self.pan_y > 0 else 5)
            self.pan_y -= math.copysign(step, self.pan_y)
        while abs(self.pan_x) >= step:
            if self.app["pan_horizontal"] == "shift":
                self.x.click(4 if self.pan_x > 0 else 5, "shift")
            else:
                self.x.click(6 if self.pan_x > 0 else 7)
            self.pan_x -= math.copysign(step, self.pan_x)

    def end(self):
        if self.app and self.app["zoom"] == "touch" and self.touch.touching:
            self.touch.lift()
            # X warps the core pointer to the emulated touch; put it back.
            self.x.move_to(self.cx, self.cy)
        self.app = None

    def close(self):
        self.end()
        if self.touch:
            self.touch.close()


# --- main -------------------------------------------------------------------

if len(sys.argv) > 1:
    if sys.argv[1] in ("-V", "--version"):
        print(f"{NAME} {__version__}")
        sys.exit(0)
    print(f"usage: {os.path.basename(sys.argv[0])} [--version]\n"
          f"config: {config_path()}", file=sys.stderr)
    sys.exit(0 if sys.argv[1] in ("-h", "--help") else 2)

if os.environ.get("XDG_SESSION_TYPE") == "wayland":
    sys.exit(f"{NAME}: X11 only (Wayland session detected)")

conf, default_app, apps = load_config()
display = X()
drag = Drag(display, conf["drag"]) if conf["drag"]["enabled"] else None
pinch = Pinch(display, conf["pinch"], default_app, apps) if conf["pinch"]["enabled"] else None
features = [f for f in (drag, pinch) if f]
failed = set()


def dispatch(line):
    event, fingers = parse(line)
    if not event:
        return
    for f in features:
        # A bug in one gesture must not take the others down.
        try:
            f.handle(event, fingers, line)
        except Exception:
            if type(f) not in failed:
                failed.add(type(f))
                warn(f"error in {type(f).__name__.lower()}:\n{traceback.format_exc()}")


def shutdown(*_):
    if drag:
        drag.release()
    if pinch:
        pinch.close()
    sys.exit(0)


def reload(*_):
    new_conf, new_default, new_apps = load_config()
    if drag:
        drag.conf = new_conf["drag"]
    if pinch:
        pinch.conf = new_conf["pinch"]
        pinch.configure(new_conf["pinch"], new_default, new_apps)


signal.signal(signal.SIGTERM, shutdown)
signal.signal(signal.SIGINT, shutdown)
# Reload the config file and apps.toml (enabling or disabling a feature needs a restart).
signal.signal(signal.SIGHUP, reload)
# Release the drag immediately (e.g. from another gesture tool).
signal.signal(signal.SIGUSR1, lambda *_: drag and drag.release())

libinput = subprocess.Popen(
    ["stdbuf", "-oL", "libinput", "debug-events"],
    stdout=subprocess.PIPE,
    bufsize=0,
)
fd = libinput.stdout.fileno()
buf = b""

while True:
    deadline = drag.deadline() if drag else None
    wait = None if deadline is None else max(0.0, deadline - time.monotonic())
    ready, _, _ = select.select([fd], [], [], wait)
    if drag:
        drag.tick(time.monotonic())
    if not ready:
        continue
    chunk = os.read(fd, 65536)
    if not chunk:
        # libinput exited (e.g. no permission on /dev/input); let systemd restart us.
        if drag:
            drag.release()
        if pinch:
            pinch.close()
        sys.exit(f"{NAME}: libinput debug-events exited (is the user in the 'input' group?)")
    *lines, buf = (buf + chunk).split(b"\n")
    for line in lines:
        dispatch(line.decode(errors="replace"))
