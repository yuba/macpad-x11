class Overlay:
    """A window drawn over everything while a gesture runs.

    An override-redirect window, so the window manager leaves it alone, drawn
    with core X requests into a pixmap and copied over in one go. Translucent
    when a compositor runs, opaque otherwise. Clicks go through it.
    """
    # Panel color, also what translucent colors are blended over without a compositor.
    PANEL = (24, 26, 30)

    def __init__(self, x):
        self.x = x
        dpy = x.dpy
        vinfo = XVisualInfo()
        self.argb = x.composited() and x11.XMatchVisualInfo(dpy, x.screen, 32, TRUE_COLOR, ctypes.byref(vinfo))
        if self.argb:
            visual, self.depth = vinfo.visual, 32
            self.colormap = x11.XCreateColormap(dpy, x.root, visual, ALLOC_NONE)
        else:
            visual, self.depth = x11.XDefaultVisual(dpy, x.screen), x11.XDefaultDepth(dpy, x.screen)
            self.colormap = 0
        attrs = XSetWindowAttributes()
        attrs.override_redirect = 1
        attrs.background_pixel = attrs.border_pixel = 0
        mask = CW_OVERRIDE_REDIRECT | CW_BACK_PIXEL | CW_BORDER_PIXEL
        if self.colormap:
            attrs.colormap = self.colormap
            mask |= CW_COLORMAP
        self.win = x11.XCreateWindow(dpy, x.root, 0, 0, 1, 1, 0, self.depth, INPUT_OUTPUT, visual, mask,
                                     ctypes.byref(attrs))
        # An empty input shape: the pointer and clicks go to the windows below.
        xext.XShapeCombineRectangles(dpy, self.win, SHAPE_INPUT, 0, 0, None, 0, SHAPE_SET, 0)
        self.gc = x11.XCreateGC(dpy, self.win, 0, None)
        self.pixmap = 0
        self.size = (0, 0)
        self.shown = False

    def place(self, w, h):
        """Make the window w x h, centered on the screen, with a fresh pixmap."""
        dpy = self.x.dpy
        if self.pixmap:
            x11.XFreePixmap(dpy, self.pixmap)
        self.pixmap = x11.XCreatePixmap(dpy, self.win, w, h, self.depth)
        x11.XMoveResizeWindow(dpy, self.win, (self.x.width - w) // 2, (self.x.height - h) // 2, w, h)
        self.size = (w, h)

    def pixel(self, r, g, b, a=255):
        if self.argb:
            # Premultiplied alpha.
            return (a << 24) | (r * a // 255 << 16) | (g * a // 255 << 8) | (b * a // 255)
        # Opaque: blend over the panel color by hand.
        r, g, b = (round(c * a / 255 + p * (255 - a) / 255) for c, p in zip((r, g, b), self.PANEL))
        return (r << 16) | (g << 8) | b

    def clear(self):
        """Start a frame: transparent with a compositor, the panel color without."""
        x11.XSetForeground(self.x.dpy, self.gc, 0 if self.argb else self.pixel(*self.PANEL))
        x11.XFillRectangle(self.x.dpy, self.pixmap, self.gc, 0, 0, *self.size)

    def rounded(self, x, y, w, h, radius, color):
        dpy, d, gc = self.x.dpy, self.pixmap, self.gc
        radius = min(radius, w // 2, h // 2)
        x11.XSetForeground(dpy, gc, color)
        x11.XFillRectangle(dpy, d, gc, x + radius, y, w - 2 * radius, h)
        x11.XFillRectangle(dpy, d, gc, x, y + radius, w, h - 2 * radius)
        for cx, cy in ((x, y), (x + w - 2 * radius, y), (x, y + h - 2 * radius), (x + w - 2 * radius, y + h - 2 * radius)):
            x11.XFillArc(dpy, d, gc, cx, cy, 2 * radius, 2 * radius, 0, 360 * 64)

    def present(self):
        """Copy the frame to the window, mapping it first if needed."""
        dpy = self.x.dpy
        w, h = self.size
        x11.XCopyArea(dpy, self.pixmap, self.win, self.gc, 0, 0, w, h, 0, 0)
        if not self.shown:
            x11.XMapRaised(dpy, self.win)
            # The window is empty until mapped; draw again on it now.
            x11.XCopyArea(dpy, self.pixmap, self.win, self.gc, 0, 0, w, h, 0, 0)
            self.shown = True
        self.x.flush()

    def hide(self):
        if self.shown:
            x11.XUnmapWindow(self.x.dpy, self.win)
            self.x.flush()
            self.shown = False

    def close(self):
        dpy = self.x.dpy
        self.hide()
        if self.pixmap:
            x11.XFreePixmap(dpy, self.pixmap)
        x11.XFreeGC(dpy, self.gc)
        x11.XDestroyWindow(dpy, self.win)
        if self.colormap:
            x11.XFreeColormap(dpy, self.colormap)
        self.x.flush()


class DesktopHud(Overlay):
    """The desktops as tiles, with a highlight that follows the fingers."""
    # The panel sits in the middle of the screen, at most this share of its
    # width and height; the tiles get the largest size that fits.
    MAX_W, MAX_H = 0.4, 0.2

    def __init__(self, x):
        super().__init__(x)
        self.grid = None    # (columns, rows) the panel is laid out for

    def layout(self, cols, rows):
        """Size the tiles, gaps and panel for a cols x rows grid of desktops."""
        sw, sh = self.x.width, self.x.height
        max_w, max_h = sw * self.MAX_W, sh * self.MAX_H
        # Padding and gaps scale with the panel; tiles keep the screen's shape.
        self.pad = round(max_h * 0.1)
        self.gap = round(self.pad * 0.6)
        fit_w = (max_w - 2 * self.pad - (cols - 1) * self.gap) / cols
        fit_h = (max_h - 2 * self.pad - (rows - 1) * self.gap) / rows * sw / sh
        self.cell_w = max(8, int(min(fit_w, fit_h)))
        self.cell_h = max(5, round(self.cell_w * sh / sw))
        self.cell_r = max(3, round(self.cell_w * 0.05))
        self.line = max(2, round(self.cell_w / 80))
        self.place(cols * self.cell_w + (cols - 1) * self.gap + 2 * self.pad,
                   rows * self.cell_h + (rows - 1) * self.gap + 2 * self.pad)
        self.grid = (cols, rows)

    def show(self, positions, current, highlight):
        """Draw tiles at positions [(column, row)], outline current, and the highlight at (column, row)."""
        grid = (max(c for c, _ in positions) + 1, max(r for _, r in positions) + 1)
        if grid != self.grid:
            self.layout(*grid)
        w, h = self.size
        dpy = self.x.dpy

        def cell(c, r):
            return (round(self.pad + c * (self.cell_w + self.gap)), round(self.pad + r * (self.cell_h + self.gap)))

        self.clear()
        self.rounded(0, 0, w, h, self.pad, self.pixel(*self.PANEL, 215))
        for c, r in positions:
            self.rounded(*cell(c, r), self.cell_w, self.cell_h, self.cell_r, self.pixel(255, 255, 255, 46))
        # The rubber band past the last desktop may stretch into the padding, not beyond.
        hx, hy = cell(*highlight)
        margin = self.pad // 2
        hx = min(max(hx, margin), w - margin - self.cell_w)
        hy = min(max(hy, margin), h - margin - self.cell_h)
        self.rounded(hx, hy, self.cell_w, self.cell_h, self.cell_r, self.pixel(10, 132, 255, 230))
        cx, cy = cell(*positions[current])
        x11.XSetForeground(dpy, self.gc, self.pixel(255, 255, 255, 230))
        x11.XSetLineAttributes(dpy, self.gc, self.line, 0, 0, 0)
        o = self.line + 1    # outline just outside the tile
        x11.XDrawRectangle(dpy, self.pixmap, self.gc, cx - o, cy - o, self.cell_w + 2 * o - 1, self.cell_h + 2 * o - 1)
        self.present()


class FingerHud(Overlay):
    """Four circles, like fingertips, that gather or spread with a pinch.

    They sit at 0, 60, 120 and 180 degrees around the middle of the screen.
    As the pinch nears the scale that triggers its action, their outline
    thickens and turns from dim white to bright yellow, until they are solid
    yellow discs.
    """
    ANGLES = (0, 60, 120, 180)
    # Furthest the circles go, as a multiple of their resting distance.
    MAX_SPREAD = 1.8

    def __init__(self, x):
        super().__init__(x)
        short = min(x.width, x.height)
        self.distance = short * 0.12     # resting distance of the circles from the middle
        self.radius = round(short * 0.035)
        side = 2 * round(self.distance * self.MAX_SPREAD + self.radius + 4)
        self.place(side, side)

    def show(self, scale, progress):
        """Draw the circles at scale times their resting distance, progress (0..1) of the way to the action."""
        dpy, r = self.x.dpy, self.radius
        side = self.size[0]
        dist = self.distance * min(max(scale, 0.0), self.MAX_SPREAD)
        p = min(max(progress, 0.0), 1.0)
        # Dim white to the brightest yellow.
        color = self.pixel(round(170 + 85 * p), round(170 + 85 * p), round(170 * (1 - p)), round(150 + 105 * p))
        width = round(3 + p * (r - 3))
        self.clear()
        x11.XSetForeground(dpy, self.gc, color)
        x11.XSetLineAttributes(dpy, self.gc, width, 0, 0, 0)
        for angle in self.ANGLES:
            a = math.radians(angle)
            cx = side / 2 + dist * math.cos(a)
            cy = side / 2 - dist * math.sin(a)
            if p >= 1:
                x11.XFillArc(dpy, self.pixmap, self.gc, round(cx - r), round(cy - r), 2 * r, 2 * r, 0, 360 * 64)
            else:
                # Keep the outer edge at radius r however thick the line.
                inner = r - width / 2
                x11.XDrawArc(dpy, self.pixmap, self.gc, round(cx - inner), round(cy - inner),
                             round(2 * inner), round(2 * inner), 0, 360 * 64)
        self.present()


# --- gestures ---------------------------------------------------------------

def parse(line):
    """Return (event, finger count or None) of a debug-events line."""
    fields = line.split()
    if len(fields) < 2:
        return None, None
    # The finger count follows the timestamp ("+1.234s"); UPDATE lines have a
    # sequence number before the timestamp, so locate it by position.
    t = next((i for i, f in enumerate(fields) if f.startswith("+") and f.endswith("s")), None)
    fingers = fields[t + 1] if t is not None and t + 1 < len(fields) else None
    return fields[1], int(fingers) if fingers and fingers.isdigit() else None


class Drag:
    IDLE, DRAGGING, GRACE = "idle", "dragging", "grace"

    def __init__(self, x, conf):
        self.x, self.conf = x, conf
        self.state = self.IDLE
        self.grace_since = 0.0
        # Sub-pixel remainder carried over between updates.
        self.rest_x = self.rest_y = 0.0

    def deadline(self):
        return self.grace_since + self.conf["timeout"] if self.state == self.GRACE else None

    def tick(self, now):
        if self.state == self.GRACE and now >= self.deadline():
            self.release()

    def release(self):
        if self.state != self.IDLE:
            self.x.button(1, False)
        self.state = self.IDLE

    def handle(self, event, fingers, line):
        if event.startswith("GESTURE_SWIPE_") and fingers == self.conf["fingers"]:
            if event == "GESTURE_SWIPE_BEGIN":
                if self.state == self.IDLE:
                    self.x.button(1, True)
                self.state = self.DRAGGING
                self.rest_x = self.rest_y = 0.0
            elif event == "GESTURE_SWIPE_UPDATE" and self.state == self.DRAGGING:
                m = DELTA_RE.search(line)
                if m:
                    self.rest_x += float(m.group(1)) * self.conf["speed"]
                    self.rest_y += float(m.group(2)) * self.conf["speed"]
                    dx, dy = int(self.rest_x), int(self.rest_y)
                    if dx or dy:
                        self.rest_x -= dx
                        self.rest_y -= dy
                        self.x.move_by(dx, dy)
            elif event == "GESTURE_SWIPE_END" and self.state == self.DRAGGING:
                self.state = self.GRACE
                self.grace_since = time.monotonic()
            return
        if self.state == self.GRACE and event in RELEASE_EVENTS \
                and time.monotonic() - self.grace_since >= self.conf["lift_guard"]:
            self.release()


def has_env(pid, requirement):
    """Whether process pid has requirement ("NAME=VALUE", or "NAME" set to anything) in its environment."""
    try:
        with open(f"/proc/{int(pid)}/environ", "rb") as f:
            env = f.read().split(b"\0")
    except (TypeError, ValueError, OSError):
        # No _NET_WM_PID, another user's process, or a pid from a sandbox's
        # own namespace (Flatpak): we cannot tell, so assume not.
        return False
    want = requirement.encode()
    if b"=" in want:
        return want in env
    return any(e.startswith(want + b"=") and len(e) > len(want) + 1 for e in env)


class Pinch:
    def __init__(self, x, conf, default_app, apps):
        self.x = x
        self.configure(conf, default_app, apps)
        try:
            self.touch = Touchscreen(x.width, x.height)
        except OSError as e:
            warn(f"cannot create the virtual touchscreen ({e}); zoom = \"touch\" falls back to \"keys\". "
                 "Is the user in the 'input' group?")
            self.touch = None
        # Settings of the app being pinched, or None between pinches.
        self.app = None

    def configure(self, conf, default_app, apps):
        self.conf, self.default_app, self.apps = conf, default_app, apps
        self.apps_folded = {key.lower(): table for key, table in apps.items()}
        # Keys like "vivaldi*" cover the names an app gets from different
        # packagings (Vivaldi-stable, Vivaldi-flatpak, ...).
        self.apps_globbed = [(key.lower(), table) for key, table in apps.items() if any(c in key for c in "*?[")]

    def settings(self, names, pid=None):
        # The class name first, then the instance name (some toolkits use a
        # generic class, e.g. "dotnet"): exactly, ignoring case, then by glob.
        names = [n for n in names if n]
        table = next((t for t in (*(self.apps.get(n) for n in names),
                                  *(self.apps_folded.get(n.lower()) for n in names)) if t is not None), None)
        if table is None:
            table = next((t for key, t in self.apps_globbed
                          if any(fnmatch.fnmatchcase(n.lower(), key) for n in names)), {})
        # Some apps handle a method only when started with some environment
        # variable; without it, they get the default instead.
        if table.get("requires_env") and not has_env(pid, table["requires_env"]):
            table = {}
        app = {**self.default_app, **table}
        if app["zoom"] == "touch" and not self.touch:
            app["zoom"] = "keys"
        return app

    def handle(self, event, fingers, line):
        if not event.startswith("GESTURE_PINCH_") or fingers != 2:
            return
        if event == "GESTURE_PINCH_BEGIN":
            self.begin()
        elif event == "GESTURE_PINCH_UPDATE" and self.app:
            m, d = SCALE_RE.search(line), DELTA_RE.search(line)
            if m and d and float(m.group(1)) > 0:
                self.update(float(m.group(1)), float(d.group(1)), float(d.group(2)))
        elif event == "GESTURE_PINCH_END":
            self.end()

    def begin(self):
        # The anchor is the pointer at the start of the pinch.
        self.cx, self.cy, win = self.x.pointer()
        self.app = self.settings(self.x.names(win) or ("", ""), self.x.pid(win))
        self.pan_x = self.pan_y = 0.0
        self.step_scale = 1.0
        if self.app["zoom"] == "touch":
            # Move the second finger toward the farthest screen corner so it
            # stays on screen as long as possible.
            w, h = self.x.width, self.x.height
            room_x = w - 1 - self.cx if self.cx < w / 2 else -self.cx
            room_y = h - 1 - self.cy if self.cy < h / 2 else -self.cy
            self.dist_max = max(1.0, math.hypot(room_x, room_y))
            self.axis = (room_x / self.dist_max, room_y / self.dist_max)
            self.dist0 = max(8.0, min(self.conf["spread"], self.dist_max / 4))

    def update(self, scale, dx, dy):
        self.pan_x += dx * self.conf["pan_speed"]
        self.pan_y += dy * self.conf["pan_speed"]
        zoom = self.app["zoom"]
        if zoom == "touch":
            dist = self.dist0 * scale
            if not self.touch.touching:
                if max(abs(min(dist, self.dist_max) - self.dist0), abs(self.pan_x), abs(self.pan_y)) \
                        < self.conf["slop"]:
                    return
                self.touch.move(self.fingers(self.dist0, 0, 0))
            self.touch.move(self.fingers(dist, self.pan_x, self.pan_y))
            return
        if zoom in ("wheel", "keys"):
            step = self.app["step"]
            while scale / self.step_scale >= step:
                self.zoom_step(True)
                self.step_scale *= step
            while self.step_scale / scale >= step:
                self.zoom_step(False)
                self.step_scale /= step
        if self.app["pan"] == "wheel":
            self.pan_steps()

    def fingers(self, dist, ox, oy):
        # The first finger sits on the anchor and the second one moves.
        # Content follows the fingers in a touch pinch, so the anchor stays
        # put, and X's pointer emulation (which tracks the first touch) leaves
        # the pointer there. Panning moves both fingers, and the pointer.
        dist = min(dist, self.dist_max)
        x0, y0 = self.cx + ox, self.cy + oy
        return (x0, y0), (x0 + self.axis[0] * dist, y0 + self.axis[1] * dist)

    def zoom_step(self, zoom_in):
        if self.app["zoom"] == "wheel":
            self.x.click(4 if zoom_in else 5, self.app["modifier"])
        else:
            self.x.key(self.app["zoom_in" if zoom_in else "zoom_out"])

    def pan_steps(self):
        # Content follows the fingers: moving them down scrolls up (button 4),
        # moving them right scrolls left (button 6 or Shift+4).
        step = self.conf["pan_step"]
        while abs(self.pan_y) >= step:
            self.x.click(4 if self.pan_y > 0 else 5)
            self.pan_y -= math.copysign(step, self.pan_y)
        while abs(self.pan_x) >= step:
            if self.app["pan_horizontal"] == "shift":
                self.x.click(4 if self.pan_x > 0 else 5, "shift")
            else:
                self.x.click(6 if self.pan_x > 0 else 7)
            self.pan_x -= math.copysign(step, self.pan_x)

    def end(self):
        if self.app and self.app["zoom"] == "touch" and self.touch.touching:
            self.touch.lift()
            # X warps the core pointer to the emulated touch; put it back.
            self.x.move_to(self.cx, self.cy)
        self.app = None

    def close(self):
        self.end()
        if self.touch:
            self.touch.close()


def desktop_grid(number, layout):
    """Return the (column, row) of each desktop for an EWMH _NET_DESKTOP_LAYOUT (orientation, columns, rows)."""
    orientation, cols, rows = layout
    if cols == 0 and rows == 0:
        cols, rows = number, 1
    elif cols == 0:
        cols = -(-number // rows)
    elif rows == 0:
        rows = -(-number // cols)
    if orientation == 1:    # vertical: fill columns first
        return [(i // rows, i % rows) for i in range(number)]
    return [(i % cols, i // cols) for i in range(number)]


class Swipe:
    """Switch to the desktop on the left or right with a sideways swipe (EWMH)."""
    # How long the HUD stays after the fingers are lifted, in seconds.
    LINGER = 0.25

    def __init__(self, x, conf, hud):
        self.x, self.conf, self.hud = x, conf, hud
        self.active = False
        self.hide_at = None

    def deadline(self):
        return self.hide_at

    def tick(self, now):
        if self.hide_at is not None and now >= self.hide_at:
            self.hide_at = None
            if self.hud:
                self.hud.hide()

    def handle(self, event, fingers, line):
        if not event.startswith("GESTURE_SWIPE_") or fingers != self.conf["fingers"]:
            return
        if event == "GESTURE_SWIPE_BEGIN":
            self.begin()
        elif event == "GESTURE_SWIPE_UPDATE" and self.active:
            m = DELTA_RE.search(line)
            if m:
                self.update(float(m.group(1)), float(m.group(2)))
        elif event == "GESTURE_SWIPE_END" and self.active:
            self.end(cancelled="cancelled" in line)

    def begin(self):
        info = self.x.desktops()
        if not info or info[0] < 2:
            return
        number, self.current, layout = info
        self.grid = desktop_grid(number, layout)
        self.current = min(self.current, number - 1)
        self.dx = self.dy = 0.0
        self.active = True

    def neighbour(self, step):
        """The desktop step columns away from the current one in its row, or None."""
        col, row = self.grid[self.current]
        cols = sorted(c for c, r in self.grid if r == row)
        target = col + step
        if self.conf["wrap"]:
            target = cols[(cols.index(col) + step) % len(cols)]
        return self.grid.index((target, row)) if (target, row) in self.grid else None

    def progress(self):
        """Return (target desktop or None, fraction of the way there)."""
        # Fingers to the left bring in the desktop on the right, like a Mac.
        step = 1 if (self.dx < 0) != self.conf["reverse"] else -1
        return self.neighbour(step), min(abs(self.dx) / self.conf["distance"], 1.0)

    def sideways(self):
        return abs(self.dx) >= abs(self.dy)

    def update(self, dx, dy):
        self.dx += dx
        self.dy += dy
        if not self.hud:
            return
        if not self.sideways():
            self.hud.hide()
            return
        if abs(self.dx) < 10:
            return
        target, fraction = self.progress()
        col, row = self.grid[self.current]
        if target is None:
            # No desktop that way: give a little and stop, like a rubber band.
            step = 1 if (self.dx < 0) != self.conf["reverse"] else -1
            highlight = (col + step * 0.15 * (1 - math.exp(-3 * fraction)), row)
        else:
            tcol, trow = self.grid[target]
            highlight = (col + (tcol - col) * fraction, row + (trow - row) * fraction)
        self.hide_at = None
        self.hud.show(self.grid, self.current, highlight)

    def end(self, cancelled):
        self.active = False
        target, fraction = self.progress()
        switch = not cancelled and self.sideways() and target is not None and fraction >= 0.5
        if switch:
            self.x.switch_desktop(target)
        if self.hud and self.hud.shown:
            self.hud.show(self.grid, self.current, self.grid[target if switch else self.current])
            self.hide_at = time.monotonic() + self.LINGER

    def close(self):
        if self.hud:
            self.hud.close()


class FourPinch:
    """Four-finger pinch: spread to show the desktop, pinch in to open a launcher.

    Pinching in while the desktop is shown brings the windows back instead.
    The window manager keeps that state (EWMH _NET_SHOWING_DESKTOP): it ends
    it by itself when a window shows up, and then the launcher opens again.
    """
    # How long the HUD stays after the fingers are lifted, in seconds.
    LINGER = 0.3

    def __init__(self, x, conf, hud):
        self.x, self.conf, self.hud = x, conf, hud
        self.active = False
        self.hide_at = None
        # Launcher commands still running, reaped as they exit.
        self.children = []

    def deadline(self):
        return self.hide_at

    def tick(self, now):
        self.children = [c for c in self.children if c.poll() is None]
        if self.hide_at is not None and now >= self.hide_at:
            self.hide_at = None
            if self.hud:
                self.hud.hide()

    def handle(self, event, fingers, line):
        if not event.startswith("GESTURE_PINCH_") or fingers != self.conf["fingers"]:
            return
        if event == "GESTURE_PINCH_BEGIN":
            self.active, self.scale = True, 1.0
        elif event == "GESTURE_PINCH_UPDATE" and self.active:
            m = SCALE_RE.search(line)
            if m and float(m.group(1)) > 0:
                self.scale = float(m.group(1))
                if self.hud:
                    self.hide_at = None
                    self.hud.show(self.scale, self.progress())
        elif event == "GESTURE_PINCH_END" and self.active:
            self.active = False
            self.end(cancelled="cancelled" in line)

    def progress(self):
        """How far (0..1) the pinch is towards the scale that triggers its action."""
        if self.scale < 1:
            return (1 - self.scale) / (1 - self.conf["in_scale"])
        return (self.scale - 1) / (self.conf["out_scale"] - 1)

    def end(self, cancelled):
        if not cancelled:
            if self.scale >= self.conf["out_scale"]:
                if self.conf["show_desktop"] and not self.x.showing_desktop():
                    self.x.show_desktop(True)
            elif self.scale <= self.conf["in_scale"]:
                if self.x.showing_desktop():
                    self.x.show_desktop(False)
                else:
                    self.launch()
        if self.hud and self.hud.shown:
            self.hide_at = time.monotonic() + self.LINGER

    def launch(self):
        if self.conf["launcher_keys"]:
            self.x.key(self.conf["launcher_keys"])
        command = self.conf["launcher_command"].strip()
        if command:
            # Its own session, so that it outlives a restart of this daemon.
            self.children.append(subprocess.Popen(["sh", "-c", command], stdin=subprocess.DEVNULL,
                                                  start_new_session=True))

    def close(self):
        if self.hud:
            self.hud.close()


