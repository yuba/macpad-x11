post_install() {
  cat <<'EOF'
==> three-finger-drag starts automatically at your next X11 login.
==> To start it now:   systemctl --user start three-finger-drag.service
==> Your user must be in the 'input' group:  sudo gpasswd -a "$USER" input
==> Config example:    /usr/share/doc/three-finger-drag/config.example.toml
==>   copy it to ~/.config/three-finger-drag/config.toml to customize.
EOF
}

post_upgrade() {
  echo "==> restart the daemon: systemctl --user restart three-finger-drag.service"
}
