#!/usr/bin/env python3
"""Check macpad-x11 without X or a touchpad: config loading, event parsing and
the drag state machine. Usage: tools/selftest [path/to/macpad-x11]"""
import os
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
# The checkout's script by default; pass a path to test an installed one.
PATH = sys.argv[1] if len(sys.argv) > 1 else os.path.join(HERE, "..", "macpad-x11")
# Everything before the main section: definitions only, no X connection.
source = open(PATH, encoding="utf-8").read().split("# --- main")[0]
g = {"__file__": PATH, "__name__": "selftest"}
exec(compile(source, PATH, "exec"), g)

conf, default_app, apps = g["load_config"]()
assert conf["drag"]["fingers"] == 3 and conf["pinch"]["enabled"] is True, conf
assert default_app["zoom"] == "keys", default_app
assert apps["evince"] == {"zoom": "wheel", "modifier": "ctrl", "step": 1.18, "pan": "wheel"}, apps["evince"]


class FakePinch:
    touch = True


p = FakePinch()
g["Pinch"].configure(p, conf["pinch"], default_app, apps)
lookup = g["Pinch"].settings
for names, zoom in ((("Vivaldi-flatpak", "vivaldi-stable"), "touch"),
                    (("Org.chromium.Chromium", "chromium"), "touch"),
                    (("Evince", "evince"), "wheel"),
                    (("firefox", "Navigator"), "keys"),          # no MOZ_USE_XINPUT2 in pid None
                    (("Xfce4-terminal", "xfce4-terminal"), "keys")):
    got = lookup(p, names)["zoom"]
    assert got == zoom, (names, got)

parse = g["parse"]
assert parse(" event7   GESTURE_PINCH_UPDATE  12 +1.012s\t2  1.00/ 2.00 ( 0.00/ 0.00 unaccelerated)  1.30 @  0.00") \
    == ("GESTURE_PINCH_UPDATE", 2)
assert parse(" event7   GESTURE_SWIPE_BEGIN     +1.000s\t3") == ("GESTURE_SWIPE_BEGIN", 3)


class FakeX:
    def __init__(self):
        self.log = []

    def button(self, b, down):
        self.log.append(("button", b, down))

    def move_by(self, dx, dy):
        self.log.append(("move", dx, dy))


def feed(drag, *lines):
    for line in lines:
        event, fingers = parse(line)
        drag.handle(event, fingers, line)


B = " event7   GESTURE_SWIPE_BEGIN     +1.000s\t3"
U = " event7   GESTURE_SWIPE_UPDATE   5 +1.010s\t3  2.00/ 1.00 ( 0.00/ 0.00 unaccelerated)"
E = " event7   GESTURE_SWIPE_END       +1.100s\t3"
M = " event7   POINTER_MOTION          +1.200s\t  1.00/  0.00 ( 0.00/ 0.00 unaccelerated)"
drag_conf = dict(conf["drag"], timeout=0.05)

x = FakeX()
d = g["Drag"](x, drag_conf)
feed(d, B, U, E)
assert d.state == d.GRACE and x.log == [("button", 1, True), ("move", 6, 3)], x.log
time.sleep(0.06)
d.tick(time.monotonic())
assert d.state == d.IDLE and x.log[-1] == ("button", 1, False)

x = FakeX()
d = g["Drag"](x, drag_conf)
feed(d, B, E, B, E, M)
assert d.state == d.IDLE and [e for e in x.log if e[0] == "button"] == [("button", 1, True), ("button", 1, False)]

class FakeDesktops:
    def __init__(self, number, current, layout=(0, 0, 1)):
        self.number, self.current, self.layout = number, current, layout
        self.switched = []

    def desktops(self):
        return self.number, self.current, self.layout

    def switch_desktop(self, index):
        self.switched.append(index)
        self.current = index


class FakeHud:
    shown = False

    def __init__(self):
        self.highlights = []

    def show(self, positions, current, highlight):
        self.shown = True
        self.highlights.append(highlight)

    def hide(self):
        self.shown = False


def swipe(s, *dxs, fingers=4, dy=0.5, cancelled=False):
    feed(s, " event7   GESTURE_SWIPE_BEGIN     +1.000s\t%d" % fingers)
    for dx in dxs:
        feed(s, " event7   GESTURE_SWIPE_UPDATE   1 +1.100s\t%d %6.2f/%5.2f ( 0.00/ 0.00 unaccelerated)"
             % (fingers, dx, dy))
    feed(s, " event7   GESTURE_SWIPE_END       +1.500s\t%d%s" % (fingers, " cancelled" if cancelled else ""))


swipe_conf = dict(conf["swipe"], distance=300.0)
xd, hud = FakeDesktops(2, 0), FakeHud()
s = g["Swipe"](xd, swipe_conf, hud)
swipe(s, *[-15] * 24)                          # fingers left past half way: next desktop
assert xd.switched == [1], xd.switched
hud.highlights.clear()
swipe(s, *[-15] * 24)                          # at the last desktop: rubber band only
furthest = max(h[0] for h in hud.highlights)
assert xd.switched == [1] and 1 < furthest < 1.2 and hud.highlights[-1] == (1, 0), (xd.switched, hud.highlights)
swipe(s, *[15] * 6)                            # less than half way back: stay
assert xd.switched == [1], xd.switched
swipe(s, *[15] * 20, cancelled=True)           # cancelled by libinput: stay
assert xd.switched == [1], xd.switched
swipe(s, *[2] * 20, dy=5.0)                    # mostly vertical: ignored
assert xd.switched == [1], xd.switched
swipe(s, *[-15] * 24, fingers=3)               # other finger count: not ours
assert xd.switched == [1], xd.switched
swipe(s, *[15] * 20)                           # fingers right all the way: previous desktop
assert xd.switched == [1, 0], xd.switched

xd = FakeDesktops(3, 2)
s = g["Swipe"](xd, dict(swipe_conf, wrap=True), None)
swipe(s, *[-15] * 20)                          # wrap from the last desktop to the first
assert xd.switched == [0], xd.switched
s = g["Swipe"](xd, dict(swipe_conf, reverse=True), None)
swipe(s, *[-15] * 20)                          # reversed: fingers left, desktop on the left
assert xd.switched == [0], xd.switched

xd = FakeDesktops(4, 1, (0, 2, 0))             # 2x2 grid; desktop 1 is top right
s = g["Swipe"](xd, swipe_conf, None)
swipe(s, *[-15] * 20)                          # nothing right of it in its row
assert xd.switched == [], xd.switched
swipe(s, *[15] * 20)                           # its left neighbour is desktop 0
assert xd.switched == [0], xd.switched

class FakeShowDesktop:
    def __init__(self):
        self.showing = False
        self.log = []

    def showing_desktop(self):
        return self.showing

    def show_desktop(self, on):
        self.log.append("show" if on else "restore")
        self.showing = on

    def key(self, spec):
        self.log.append("key " + spec)


def pinch4(p, *scales, fingers=4, cancelled=False):
    feed(p, " event7   GESTURE_PINCH_BEGIN     +1.000s\t%d" % fingers)
    for sc in scales:
        feed(p, " event7   GESTURE_PINCH_UPDATE   1 +1.100s\t%d  0.00/ 0.00 ( 0.00/ 0.00 unaccelerated)  %.2f @  0.00"
             % (fingers, sc))
    feed(p, " event7   GESTURE_PINCH_END       +1.500s\t%d%s" % (fingers, " cancelled" if cancelled else ""))


p4conf = dict(conf["pinch4"], launcher_keys="super", launcher_command="")
assert "xfce4-popup-whiskermenu ||" in conf["pinch4"]["launcher_command"].splitlines()
xs = FakeShowDesktop()
p4 = g["FourPinch"](xs, p4conf, None)
pinch4(p4, 0.9, 0.6)                       # pinch in: launcher
assert xs.log == ["key super"], xs.log
pinch4(p4, 1.2, 1.7)                       # spread: show the desktop
assert xs.log[-1] == "show" and xs.showing, xs.log
pinch4(p4, 1.2, 1.7)                       # spread again: already shown, nothing
assert xs.log.count("show") == 1, xs.log
pinch4(p4, 0.9, 0.6)                       # pinch in while shown: windows back
assert xs.log[-1] == "restore" and not xs.showing, xs.log
pinch4(p4, 0.9, 0.6)                       # and the next one opens the launcher again
assert xs.log[-1] == "key super", xs.log
pinch4(p4, 1.7)
xs.showing = False                         # a window appeared: the WM left the mode
pinch4(p4, 0.6)
assert xs.log[-2:] == ["show", "key super"], xs.log
n = len(xs.log)
pinch4(p4, 0.85)                           # not far enough
pinch4(p4, 1.3)
pinch4(p4, 0.5, cancelled=True)            # cancelled
pinch4(p4, 0.5, fingers=2)                 # a two-finger pinch is not ours
pinch4(p4, 0.5, 1.0)                       # back to where it started before lifting
assert len(xs.log) == n, xs.log[n:]
assert abs(g["FourPinch"].progress(type("P", (), {"scale": 0.85, "conf": p4conf})()) - 0.5) < 1e-9

print("selftest passed on Python %d.%d.%d" % sys.version_info[:3])
