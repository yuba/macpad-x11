#!/usr/bin/env python3
"""Find out how macpad-x11 should drive an application, and print its apps.ini entry.

Point at a window (or pass --window). probe replays synthetic pinches through
../macpad-x11 with each zoom method forced for that window's WM_CLASS,
measures how the content moved, and prints an apps.ini entry for the best
method. It then checks wheel panning with that method, and saves a contact
sheet with every before/after pair (pointer marked with a red cross) so the
verdicts can be checked by eye.

A method suits the app when it zooms the content and keeps what was under the
pointer under the pointer ("anchored"). Zooming is measured by finding the
patch around the pointer after the pinch in the screenshot before it, at
every plausible scale (OpenCV template matching), so use a detailed,
non-repeating document such as the grids from tools/make-testdata.

Synthetic pinches are fed to macpad-x11 through a fake `libinput` command, so
the touchpad is not needed and the running macpad-x11 service is unaffected.
Requires numpy and OpenCV (pip install numpy opencv-python-headless).
"""
import argparse
import math
import os
import shlex
import subprocess
import sys
import tempfile
import time

import cv2
import numpy as np

HERE = os.path.dirname(os.path.realpath(__file__))
MACPAD = os.path.join(HERE, "..", "macpad-x11")
# In order of preference. Ctrl+wheel beats a plain wheel so that the plain
# wheel stays free for panning.
ZOOMS = {
    "touch": {"zoom": "touch"},
    "ctrl-wheel": {"zoom": "wheel", "modifier": "ctrl"},
    "wheel": {"zoom": "wheel", "modifier": ""},
    "keys": {"zoom": "keys"},
}
STEP = 1.2
TARGET = 2.0
# Number of wheel clicks or key presses macpad-x11 makes for a TARGET pinch.
CLICKS = math.floor(math.log(TARGET) / math.log(STEP) + 1e-9)
PATCH = 280
# Classes shared by unrelated apps; key such apps by their instance name.
GENERIC_CLASSES = {"dotnet", "java", "python", "python3", "wine", "electron"}


def xdotool(*args):
    try:
        return subprocess.run(["xdotool", *args], capture_output=True, text=True, timeout=20).stdout.strip()
    except subprocess.TimeoutExpired:
        return ""


def shell_vars(text):
    return dict(line.split("=", 1) for line in text.splitlines() if "=" in line)


def ini_table(settings):
    return "\n".join(f"{k} = {v:g}" if isinstance(v, float) else f"{k} = {v}" for k, v in settings.items())


def pinch_lines(scales, dx=0.0, dy=0.0):
    lines = [" event7   GESTURE_PINCH_BEGIN     +1.000s\t2"]
    for i, s in enumerate(scales, 1):
        lines.append(f" event7   GESTURE_PINCH_UPDATE  {i:3d} +1.{i:03d}s\t2 {dx:5.2f}/{dy:5.2f} "
                     f"( 0.00/ 0.00 unaccelerated)  {s:.2f} @  0.00")
    lines.append(" event7   GESTURE_PINCH_END       +2.000s\t2")
    return lines


def ramp(target, n=8):
    return [1 + (target - 1) * i / n for i in range(1, n + 1)]


def run_pinch(tmp, cls, settings, lines):
    """Run macpad-x11 once with the given app settings on a fake event stream."""
    conf_dir = os.path.join(tmp, "config", "macpad-x11")
    os.makedirs(conf_dir, exist_ok=True)
    with open(os.path.join(conf_dir, "config.ini"), "w") as f:
        f.write(f"[drag]\nenabled = no\n\n[app {cls}]\n{ini_table(settings)}\n")
    seq = os.path.join(tmp, "seq.txt")
    with open(seq, "w") as f:
        f.write("\n".join(lines) + "\n")
    bindir = os.path.join(tmp, "bin")
    os.makedirs(bindir, exist_ok=True)
    fake = os.path.join(bindir, "libinput")
    # The virtual touchscreen needs time to be hotplugged into X.
    warmup = 2.5 if settings.get("zoom") == "touch" else 0.5
    with open(fake, "w") as f:
        f.write(f"#!/bin/sh\nsleep {warmup}\n"
                f"while IFS= read -r l; do printf '%s\\n' \"$l\"; sleep 0.05; done < {shlex.quote(seq)}\n"
                "sleep 0.3\n")
    os.chmod(fake, 0o755)
    env = dict(os.environ, XDG_CONFIG_HOME=os.path.join(tmp, "config"),
               PATH=bindir + os.pathsep + os.environ["PATH"])
    subprocess.run([sys.executable, MACPAD], env=env, stderr=subprocess.DEVNULL)


def measure(before, after, p):
    """Return (scale, where the content now under p was before, match score)."""
    # Color matters: the grid cells differ mostly by color.
    a = cv2.imread(after, cv2.IMREAD_COLOR)
    b = cv2.imread(before, cv2.IMREAD_COLOR)
    h, w = a.shape[:2]
    x0 = min(max(p[0] - PATCH // 2, 0), w - PATCH)
    y0 = min(max(p[1] - PATCH // 2, 0), h - PATCH)
    patch = a[y0:y0 + PATCH, x0:x0 + PATCH]
    # p relative to the patch, so the match location maps back to p exactly.
    off = (p[0] - x0, p[1] - y0)
    best = (0.0, None, -1.0)
    for s in np.geomspace(0.33, 4.0, 90):
        size = round(PATCH / s)
        if size < 20 or size >= min(b.shape[:2]):
            continue
        t = cv2.resize(patch, (size, size), interpolation=cv2.INTER_AREA)
        res = cv2.matchTemplate(b, t, cv2.TM_CCOEFF_NORMED)
        _, score, _, loc = cv2.minMaxLoc(res)
        if score > best[2]:
            q = (loc[0] + off[0] / s, loc[1] + off[1] / s)
            best = (float(s), q, float(score))
    return best


def verdict(scale, q, score, p, size):
    if score < 0.5 or q is None:
        return "unclear", None
    drift = math.dist(q, p)
    if abs(scale - 1) < 0.04:
        return ("no change" if drift < 4 else f"moved {q[0] - p[0]:+.0f},{q[1] - p[1]:+.0f} (no zoom)"), drift
    if scale < 1:
        return "zoomed OUT (inverted)", drift
    if drift <= max(10.0, 0.012 * max(size)):
        return "anchored", drift
    return "zooms off-pointer", drift


def shot(raw, sheet, geo, rel, label):
    x, y, w, h = (int(geo[k]) for k in ("X", "Y", "WIDTH", "HEIGHT"))
    rx, ry = rel
    subprocess.run(["import", "-window", "root", "-crop", f"{w}x{h}+{x}+{y}", "+repage", raw], check=True)
    subprocess.run(["magick", raw, "-stroke", "red", "-strokewidth", "3",
                    "-draw", f"line {rx - 25},{ry} {rx + 25},{ry}",
                    "-draw", f"line {rx},{ry - 25} {rx},{ry + 25}",
                    "-fill", "none", "-draw", f"circle {rx},{ry} {rx + 14},{ry}",
                    "-resize", "640x640>", "-set", "label", label, sheet], check=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--window", help="window id (default: the window under the pointer after a countdown)")
    ap.add_argument("--at", default="0.3,0.4", help="pointer position as fractions of the window size")
    ap.add_argument("--zooms", default=",".join(ZOOMS), help="zoom methods to try")
    ap.add_argument("--no-pan", action="store_true", help="skip the panning check")
    ap.add_argument("--settle", type=float, default=1.0, help="seconds to wait for the app to redraw")
    ap.add_argument("-o", "--output", default="probe.png", help="contact sheet to write")
    args = ap.parse_args()

    win = args.window
    if not win:
        for i in range(3, 0, -1):
            print(f"point at the window... {i}", file=sys.stderr)
            time.sleep(1)
        win = shell_vars(xdotool("getmouselocation", "--shell"))["WINDOW"]
    cls = xdotool("getwindowclassname", win)
    # WM_CLASS(STRING) = "instance", "class"
    wm_class = subprocess.run(["xprop", "-id", win, "WM_CLASS"], capture_output=True, text=True).stdout
    instance = wm_class.split('"')[1] if wm_class.count('"') >= 4 else ""
    key = instance if cls.lower() in GENERIC_CLASSES and instance else cls
    geo = shell_vars(xdotool("getwindowgeometry", "--shell", win))
    size = (int(geo["WIDTH"]), int(geo["HEIGHT"]))
    fx, fy = map(float, args.at.split(","))
    rel = (int(size[0] * fx), int(size[1] * fy))
    px, py = int(geo["X"]) + rel[0], int(geo["Y"]) + rel[1]
    print(f"window {win}, WM_CLASS {cls!r} (instance {instance!r}), {size[0]}x{size[1]}, pointer at {px},{py}")

    def prepare():
        xdotool("windowactivate", "--sync", win)
        xdotool("mousemove", str(px), str(py))
        time.sleep(0.4)

    with tempfile.TemporaryDirectory() as tmp:
        sheets = []

        def snap(label):
            time.sleep(args.settle)
            n = len(sheets)
            raw, sheet = os.path.join(tmp, f"raw{n:02d}.png"), os.path.join(tmp, f"sheet{n:02d}.png")
            shot(raw, sheet, geo, rel, label)
            sheets.append(sheet)
            return raw

        results = {}
        for name in args.zooms.split(","):
            zs = {**ZOOMS[name], "pan": "none", "step": STEP}
            # Pinch twice and judge the second one: viewers that start with the
            # whole document fitted keep it centered until it overflows.
            prepare()
            run_pinch(tmp, cls, zs, pinch_lines(ramp(TARGET)))
            prepare()
            before = snap(f"{name}: after one pinch out")
            run_pinch(tmp, cls, zs, pinch_lines(ramp(TARGET)))
            after = snap(f"{name}: after a second pinch out")
            scale, q, score = measure(before, after, rel)
            results[name] = (scale, *verdict(scale, q, score, rel, size))
            drift = results[name][2]
            print(f"  {name:10s} scale {scale:4.2f}  drift {'-' if drift is None else f'{drift:4.0f}px'}"
                  f"  {results[name][1]}")
            for _ in range(2):
                prepare()
                run_pinch(tmp, cls, zs, pinch_lines(ramp(1 / TARGET)))

        good = [n for n, (s, v, _) in results.items() if v == "anchored" and s > 1.1]
        best = good[0] if good else None
        entry = {}
        if best:
            entry = dict(ZOOMS[best])
            if best != "touch":
                entry["step"] = round(results[best][0] ** (1 / CLICKS), 2)
        else:
            print("  no anchored zoom method found; keys (the default) zoom around the app's center")

        if best and best != "touch" and not args.no_pan:
            zs = {**ZOOMS[best], "pan": "none", "step": STEP}
            prepare()
            run_pinch(tmp, cls, zs, pinch_lines(ramp(TARGET)))
            moves = {}
            for horizontal in ("buttons", "shift"):
                ps = {"zoom": "none", "pan": "wheel", "pan_horizontal": horizontal}
                prepare()
                before = snap(f"{best} {TARGET:g}x: before pan")
                # Fingers move down and to the right; the content should follow.
                run_pinch(tmp, cls, ps, pinch_lines([1.0] * 10, 12.0, 12.0))
                after = snap(f"pan, horizontal = {horizontal}")
                scale, q, score = measure(before, after, rel)
                moves[horizontal] = None if score < 0.5 or q is None or abs(scale - 1) > 0.04 else \
                    (rel[0] - q[0], rel[1] - q[1])
                mv = moves[horizontal]
                print(f"  pan {horizontal:8s} " + ("unclear" if mv is None else f"content moved {mv[0]:+.0f},{mv[1]:+.0f}"))
                prepare()
                run_pinch(tmp, cls, ps, pinch_lines([1.0] * 10, -12.0, -12.0))
            prepare()
            run_pinch(tmp, cls, zs, pinch_lines(ramp(1 / TARGET)))
            vertical = any(m and m[1] > 10 for m in moves.values())
            horizontal = [h for h, m in moves.items() if m and m[0] > 10]
            if vertical or horizontal:
                entry["pan"] = "wheel"
                if horizontal and horizontal[0] != "buttons":
                    entry["pan_horizontal"] = horizontal[0]

        subprocess.run(["montage", "-font", "DejaVu-Sans", "-pointsize", "18", *sheets,
                        "-tile", "2x", "-geometry", "+6+6", "-background", "#ddd", args.output], check=True)
    if entry:
        print(f"\nsuggested apps.ini entry:\n\n[app {key}]\n{ini_table(entry)}\n")
    print(f"contact sheet: {args.output}")


if __name__ == "__main__":
    main()
